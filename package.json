    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentTandem",
          "title": "Agent Tandem",
          "icon": "media/tandem.svg"
        }
      ]
    },
    "views": {
      "agentTandem": [
        {
          "id": "agentTandem.panel",
          "name": "Agent Tandem",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "agentTandem.header.more",
          "when": "view == agentTandem.panel",
          "group": "navigation@5"
        }
      ],
      "editor/title": [
        {
          "command": "agentTandem.previousFile",
          "when": "agentTandem.multipleChangedFiles",
          "group": "navigation@1"
        },
        {
          "command": "agentTandem.chooseChangedFile",
          "when": "agentTandem.changeNavigation",
          "group": "navigation@2"
        },
        {
          "command": "agentTandem.nextFile",
          "when": "agentTandem.multipleChangedFiles",
          "group": "navigation@3"
        },
        {
          "command": "agentTandem.openImageChanges",
          "when": "resourceExtname =~ /^.(png|apng|jpe?g|jfif|gif|webp|bmp|ico|avif|svg|tiff?)$/i && gitOpenRepositoryCount != 0 && !agentTandem.changeNavigation",
          "group": "navigation@9"
        }
      ],
      "editor/content": [
        {
          "command": "agentTandem.previousChange",
          "when": "editorFocus && isInDiffEditor && activeEditor != multiDiffEditor && resource in agentTandem.changeModifiedResources",
          "group": "navigation@1"
        },
        {
          "command": "agentTandem.nextChange",
          "when": "editorFocus && isInDiffEditor && activeEditor != multiDiffEditor && resource in agentTandem.changeModifiedResources",
          "group": "navigation@2"
        }
      ],
      "multiDiffEditor/content": [
        {
          "command": "agentTandem.previousChange",
          "when": "agentTandem.changeNavigation",
          "group": "navigation@1"
        },
        {
          "command": "agentTandem.nextChange",
          "when": "agentTandem.changeNavigation",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "agentTandem.previousFile",
          "when": "agentTandem.multipleChangedFiles"
        },
        {
          "command": "agentTandem.nextFile",
          "when": "agentTandem.multipleChangedFiles"
        },
        {
          "command": "agentTandem.chooseChangedFile",
          "when": "agentTandem.changeNavigation"
        },
        {
          "command": "agentTandem.acceptCurrentChange",
          "when": "false"
        },
        {
          "command": "agentTandem.revertCurrentChange",
          "when": "false"
        },
        {
          "command": "agentTandem.acceptHunk",
          "when": "false"
        },
        {
          "command": "agentTandem.rejectHunk",
          "when": "false"
        },
        {
          "command": "agentTandem.previousChange",
          "when": "agentTandem.changeNavigation"
        },
        {
          "command": "agentTandem.nextChange",
          "when": "agentTandem.changeNavigation"
        },
        {
          "command": "agentTandem.openImageChanges",
          "when": "resourceExtname =~ /^.(png|apng|jpe?g|jfif|gif|webp|bmp|ico|avif|svg|tiff?)$/i"
        },
        {
          "command": "agentTandem.header.newChat",
          "when": "false"
        },
        {
          "command": "agentTandem.header.history",
          "when": "false"
        },
        {
          "command": "agentTandem.header.review",
          "when": "false"
        },
        {
          "command": "agentTandem.header.refresh",
          "when": "false"
        },
        {
          "command": "agentTandem.header.more",
          "when": "false"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "agentTandem.openImageChanges",
          "when": "scmProvider == git && scmResourceGroup =~ /^(index|workingTree|untracked)$/",
          "group": "navigation@9"
        }
      ]
    },
    "keybindings": [
      {
        "command": "agentTandem.previousFile",
        "key": "alt+pageup",
        "when": "agentTandem.multipleChangedFiles && editorTextFocus"
      },
      {
        "command": "agentTandem.nextFile",
        "key": "alt+pagedown",
        "when": "agentTandem.multipleChangedFiles && editorTextFocus"
      },
      {
        "command": "agentTandem.acceptCurrentChange",
        "key": "alt+y",
        "when": "agentTandem.canDecideHunk && editorTextFocus"
      },
      {
        "command": "agentTandem.revertCurrentChange",
        "key": "alt+n",
        "when": "agentTandem.canDecideHunk && editorTextFocus"
      },
      {
        "command": "agentTandem.nextChange",
        "key": "alt+down",
        "when": "agentTandem.changeNavigation && editorTextFocus && isInDiffEditor"
      },
      {
        "command": "agentTandem.previousChange",
        "key": "alt+up",
        "when": "agentTandem.changeNavigation && editorTextFocus && isInDiffEditor"
      }
    ],
    "configuration": {
      "title": "AgentTandem",
      "properties": {
        "agentTandem.showQuotaInStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show agent quota in the VS Code status bar. Customize agents and details in AgentTandem Settings > Preferences."
        },
        "agentTandem.statusBarProviders": {
          "type": "string",
          "enum": [
            "both",
            "active",
            "codex",
            "claude"
          ],
          "enumDescriptions": [
            "Show Codex and Claude Code together.",
            "Show only the agent selected in chat.",
            "Show only Codex.",
            "Show only Claude Code."
          ],
          "default": "both",
          "description": "Agents shown in the status bar. Each agent has its own quota and hover details."
        },
        "agentTandem.statusBarStyle": {
          "type": "string",
          "enum": [
            "compact",
            "progress",
            "rings",
            "minimal",
            "icons",
            "text"
          ],
          "enumDescriptions": [
            "Distinct agent icons with quota and a short banked reset count.",
            "Agent icons with detailed progress bars and percentages showing remaining quota.",
            "Agent icons with a quota ring and percentage for each window.",
            "Narrowest meter: one column per quota window and only the lowest remaining percentage; hover names each window.",
            "Agent icons only; hover for account, quota and reset details.",
            "Agent icons with full detail labels."
          ],
          "default": "compact",
          "description": "Appearance of the agent quota status items. Uses the Codex blossom and Claude starburst provider icons, and ↻ for banked resets."
        },
        "agentTandem.statusBarFields": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "quota",
              "reset",
              "bankedResets",
              "account",
              "plan"
            ]
          },
          "uniqueItems": true,
          "default": [
            "quota",
            "bankedResets"
          ],
          "description": "Details shown beside each agent, in this order: remaining quota, quota reset countdown, banked reset count, account and plan. With remaining quota shown, each reset countdown follows its quota window after a clock icon, shortened to two units such as 2h14m or 3d4h; the Text style keeps the spelled-out form. Hover always shows full details. An empty list shows agent icons only."
        },
        "agentTandem.statusBarQuotaWindows": {
          "type": "string",
          "enum": [
            "all",
            "main"
          ],
          "default": "all",
          "description": "Show all reported quota windows, or only the first two for a shorter status bar. Hover always shows every window."
        },
        "agentTandem.statusBarAlignment": {
          "type": "string",
          "enum": [
            "right",
            "left"
          ],
          "default": "right",
          "description": "Side of the VS Code status bar used for agent quota."
        },
        "agentTandem.statusBarCodexColor": {
          "type": "string",
          "default": "",
          "pattern": "^(|statusBar[.]foreground|charts[.](blue|green|orange|purple|red|yellow)|#[0-9a-fA-F]{6})$",
          "patternErrorMessage": "Leave empty, use a theme color such as charts.blue, or #RRGGBB.",
          "markdownDescription": "Text color of the Codex status bar item. Empty uses the quota status color (green while quota is healthy). Use a theme color (`statusBar.foreground`, `charts.blue`, `charts.green`, `charts.orange`, `charts.purple`, `charts.red`, `charts.yellow`) or `#RRGGBB`. Low and exhausted quota keep their warning colors."
        },
        "agentTandem.statusBarClaudeColor": {
          "type": "string",
          "default": "",
          "pattern": "^(|statusBar[.]foreground|charts[.](blue|green|orange|purple|red|yellow)|#[0-9a-fA-F]{6})$",
          "patternErrorMessage": "Leave empty, use a theme color such as charts.blue, or #RRGGBB.",
          "markdownDescription": "Text color of the Claude Code status bar item. Empty uses the quota status color (green while quota is healthy). Use a theme color (`statusBar.foreground`, `charts.blue`, `charts.green`, `charts.orange`, `charts.purple`, `charts.red`, `charts.yellow`) or `#RRGGBB`. Low and exhausted quota keep their warning colors."
        },
        "agentTandem.usageDashboardDefaultGrouping": {
          "type": "string",
          "enum": [
            "day",
            "week",
            "month"
          ],
          "default": "day",
          "description": "Default calendar grouping for the AgentTandem usage dashboard. Weeks start on Monday."
        },
        "agentTandem.reviewEditor": {
          "type": "string",
          "enum": [
            "webview",
            "native"
          ],
          "default": "webview",
          "enumDescriptions": [
            "Use the Monaco diff editor with syntax highlighting and colored inline Accept, Reject and navigation buttons in every edition.",
            "Use VS Code's native diff editor with the available in-editor review controls."
          ],
          "description": "Editor used to review pending changes. The Webview review editor works without experimental APIs."
        },
        "agentTandem.blockActionsStyle": {
          "type": "string",
          "enum": [
            "auto",
            "lens",
            "off"
          ],
          "enumDescriptions": [
            "Show a card with Accept, Reject and Next change buttons above each pending block, falling back to the code lens row when the editor-inset API is unavailable.",
            "Always use the compact Accept | Reject | Next change code lens row.",
            "No in-editor block actions; review files from the AgentTandem sidebar."
          ],
          "default": "lens",
          "description": "Block actions in the native diff editor. Native mode uses CodeLens. The default Monaco Webview review uses colored inline buttons. Opening a native review enables diffEditor.codeLens."
        },
        "agentTandem.openGitImageDiffs": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Open image changes from Source Control in AgentTandem's Before / After view. VS Code's built-in Git image diff fails with `Cannot read properties of undefined (reading 'selection')` and closes."
        },
        "agentTandem.showFileCounterInEditor": {
          "type": "boolean",
          "default": true,
          "description": "Show a File i/n button at the top of AgentTandem native diff editors. Click to choose a changed file. The button scrolls with the code."
        },
        "agentTandem.revealReviewFileInExplorer": {
          "type": "boolean",
          "default": true,
          "description": "Select the file being reviewed in the Explorer as you move between changed files. Keyboard focus stays in the editor."
        },
        "agentTandem.codexCLIId": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Managed Codex CLI entry selected for this project. Set through Manage CLIs; follows executable path edits. Takes precedence over codexExecutable."
        },
        "agentTandem.claudeCLIId": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Managed Claude CLI entry selected for this project. Set through Manage CLIs; follows executable path edits. Takes precedence over claudeExecutable."
        },
        "agentTandem.codexExecutable": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to an enabled native Codex executable in Manage CLIs. Uses the managed default when empty; automatic selection tries a valid PATH Codex, then the current VS Code host's Codex extension. A managed project entry ID takes precedence.",
          "scope": "resource"
        },
        "agentTandem.claudeExecutable": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to an enabled Claude executable in Manage CLIs. A managed project entry ID takes precedence.",
          "scope": "resource"
        },
        "agentTandem.codexCLISelection": {
          "type": "string",
          "enum": [
            "default",
            "terminal"
          ],
          "default": "default",
          "scope": "resource",
          "description": "Use the managed default/explicit executable (automatic: valid PATH Codex, then current Codex extension), or require the enabled terminal CLI on PATH. Configure this in Manage CLIs."
        },
        "agentTandem.claudeCLISelection": {
          "type": "string",
          "enum": [
            "default",
            "terminal"
          ],
          "default": "default",
          "scope": "resource",
          "description": "Use the managed default/explicit executable, or the enabled terminal CLI on PATH. Configure this in Manage CLIs."
        },
        "agentTandem.autoTrackExternalChanges": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start change tracking in trusted local workspaces that have no saved tracking choice. Pause/resume is remembered separately per workspace."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "gettingStarted",
        "title": "Welcome to AgentTandem",
        "description": "Use Codex and Claude your way. Track saved changes, review code and understand your usage.",
        "steps": [
          {
            "id": "tracking",
            "title": "1. Find change tracking in the status bar",
            "description": "Tracking starts automatically in trusted local workspaces. Click Tracking in the bottom status bar to control it. Manual saves are included.\n[Open tracking controls](command:agentTandem.trackingControls)",
            "media": {
              "markdown": "docs/onboarding/tracking.md"
            },
            "completionEvents": [
              "onCommand:agentTandem.trackingControls"
            ]
          },
          {
            "id": "review",
            "title": "2. Review files and individual change blocks",
            "description": "Keep applied code with Accept, or restore a saved baseline with Revert.\n[Open AgentTandem](command:agentTandem.open)",
            "media": {
              "markdown": "docs/onboarding/review.md"
            },
            "completionEvents": [
              "onCommand:agentTandem.previewReview"
            ]
          },
          {
            "id": "chat",
            "title": "3. Connect your native CLIs",
            "description": "Use the original Codex/Claude tools or chat here. Tracking works with both workflows.\n[Manage CLIs](command:agentTandem.manageCLIs)",
            "media": {
              "markdown": "docs/onboarding/chat.md"
            },
            "completionEvents": [
              "onCommand:agentTandem.manageCLIs"
            ]
          },
          {
            "id": "usage",
            "title": "4. Check account, quota and token usage",
            "description": "See where every number comes from: API, Local or Estimate.\n[Open dashboard](command:agentTandem.openSettings)",
            "media": {
              "markdown": "docs/onboarding/usage.md"
            },
            "completionEvents": [
              "onCommand:agentTandem.openSettings"
            ]
          }
        ]
      }
    ]
  },
