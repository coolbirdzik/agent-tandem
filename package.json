{
  "name": "agent-tandem",
  "displayName": "AgentTandem — Claude Code & Codex Chat, Code Review & Usage",
  "description": "Chat with Claude Code and Codex, review code changes, restore checkpoints, resume conversations and track usage in VS Code.",
  "version": "0.1.15",
  "publisher": "agent-tandem-local",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/coolbirdzik/agent-tandem.git"
  },
  "homepage": "https://github.com/coolbirdzik/agent-tandem#readme",
  "bugs": {
    "url": "https://github.com/coolbirdzik/agent-tandem/issues"
  },
  "license": "UNLICENSED",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#242623",
    "theme": "dark"
  },
  "keywords": [
    "claude",
    "claude code",
    "codex",
    "codex cli",
    "ai agents",
    "ai",
    "code review",
    "checkpoints",
    "chat",
    "usage"
  ],
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "enabledApiProposals": [
    "contribEditorContentMenu",
    "editorInsets"
  ],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Snapshot review works; local provider processes require a local workspace."
    },
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "View saved steps. Running the demo or provider probes requires workspace trust."
    }
  },
  "contributes": {
    "icons": {
      "agent-tandem-codex": {
        "description": "AgentTandem Codex provider logo",
        "default": { "fontPath": "./media/provider-icons.ttf", "fontCharacter": "\\E001" }
      },
      "agent-tandem-claude": {
        "description": "AgentTandem Claude Code provider logo",
        "default": { "fontPath": "./media/provider-icons.ttf", "fontCharacter": "\\E002" }
      }
    },
    "commands": [
      {
        "command": "agentTandem.quickAccounts",
        "title": "AgentTandem: Quota and Quick Account Switch",
        "icon": "$(account)"
      },
      {
        "command": "agentTandem.manageAccounts",
        "title": "AgentTandem: Manage Accounts",
        "icon": "$(account)"
      },
      {
        "command": "agentTandem.acceptCurrentChange",
        "title": "Accept change",
        "icon": "$(check)",
        "enablement": "agentTandem.canDecideHunk"
      },
      {
        "command": "agentTandem.revertCurrentChange",
        "title": "Revert change",
        "icon": "$(discard)",
        "enablement": "agentTandem.canDecideHunk"
      },
      {
        "command": "agentTandem.acceptHunk",
        "title": "Accept this change block",
        "icon": "$(check)"
      },
      {
        "command": "agentTandem.rejectHunk",
        "title": "Reject this change block",
        "icon": "$(discard)"
      },
      {
        "command": "agentTandem.previousChange",
        "title": "Previous change",
        "icon": "$(arrow-up)"
      },
      {
        "command": "agentTandem.nextChange",
        "title": "Next change",
        "icon": "$(arrow-down)"
      },
      {
        "command": "agentTandem.previousFile",
        "title": "Previous file",
        "icon": "$(chevron-left)",
        "enablement": "agentTandem.multipleChangedFiles"
      },
      {
        "command": "agentTandem.nextFile",
        "title": "Next file",
        "icon": "$(chevron-right)",
        "enablement": "agentTandem.multipleChangedFiles"
      },
      {
        "command": "agentTandem.chooseChangedFile",
        "title": "Choose changed file",
        "icon": "$(files)",
        "enablement": "agentTandem.changeNavigation"
      },
      {
        "command": "agentTandem.open",
        "title": "AgentTandem: Open Conversations"
      },
      {
        "command": "agentTandem.openSettings",
        "title": "AgentTandem: Open Settings and Usage Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "agentTandem.openStorage",
        "title": "AgentTandem: Manage Storage",
        "icon": "$(database)"
      },
      {
        "command": "agentTandem.runDemo",
        "title": "AgentTandem: Run Step Demo",
        "icon": "$(play)"
      },
      {
        "command": "agentTandem.stop",
        "title": "AgentTandem: Stop Demo",
        "icon": "$(debug-stop)"
      },
      {
        "command": "agentTandem.openStep",
        "title": "AgentTandem: View Step Changes",
        "icon": "$(diff)"
      },
      {
        "command": "agentTandem.openCumulative",
        "title": "AgentTandem: View Cumulative Changes"
      },
      {
        "command": "agentTandem.openFile",
        "title": "AgentTandem: View File Changes"
      },
      {
        "command": "agentTandem.checkProviders",
        "title": "AgentTandem: Check Providers",
        "icon": "$(plug)"
      },
      {
        "command": "agentTandem.syncConversations",
        "title": "AgentTandem: Refresh Project Conversations",
        "icon": "$(refresh)"
      },
      {
        "command": "agentTandem.openConversation",
        "title": "AgentTandem: Open Conversation"
      },
      {
        "command": "agentTandem.openInTab",
        "title": "AgentTandem: Open in Editor Tab",
        "icon": "$(link-external)"
      },
      {
        "command": "agentTandem.openStepInEditor",
        "title": "AgentTandem: Open Step Diff in Editor"
      },
      {
        "command": "agentTandem.openFileInEditor",
        "title": "AgentTandem: Open File Diff in Editor"
      },
      {
        "command": "agentTandem.openCumulativeInEditor",
        "title": "AgentTandem: Open Cumulative Diff in Editor"
      },
      {
        "command": "agentTandem.manageCLIs",
        "title": "AgentTandem: Manage CLIs"
      },
      {
        "command": "agentTandem.toggleExternalReview",
        "title": "AgentTandem: Toggle External Change Tracking",
        "icon": "$(eye)"
      },
      {
        "command": "agentTandem.captureExternalChanges",
        "title": "AgentTandem: Capture External Changes Now",
        "icon": "$(refresh)"
      },
      {
        "command": "agentTandem.reviewLatest",
        "title": "AgentTandem: Review Latest Changes"
      },
      {
        "command": "agentTandem.undoRevert",
        "title": "AgentTandem: Undo Last Revert"
      },
      {
        "command": "agentTandem.trackingControls",
        "title": "AgentTandem: Change Tracking Controls",
        "icon": "$(eye)"
      },
      {
        "command": "agentTandem.gettingStarted",
        "title": "AgentTandem: Getting Started",
        "icon": "$(book)"
      },
      {
        "command": "agentTandem.refreshStorage",
        "title": "AgentTandem: Refresh Storage Usage"
      },
      {
        "command": "agentTandem.previewStorageCleanup",
        "title": "AgentTandem: Preview Storage Cleanup"
      },
      {
        "command": "agentTandem.cleanupStorage",
        "title": "AgentTandem: Clean Unused Snapshots"
      },
      {
        "command": "agentTandem.revealStorage",
        "title": "AgentTandem: Reveal Data Folder"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentTandem",
          "title": "AgentTandem",
          "icon": "media/tandem.svg"
        }
      ]
    },
    "views": {
      "agentTandem": [
        {
          "id": "agentTandem.panel",
          "name": "Review",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [],
      "editor/title": [
        {
          "command": "agentTandem.previousFile",
          "when": "agentTandem.multipleChangedFiles",
          "group": "navigation@1"
        },
        {
          "command": "agentTandem.chooseChangedFile",
          "when": "agentTandem.changeNavigation",
          "group": "navigation@2"
        },
        {
          "command": "agentTandem.nextFile",
          "when": "agentTandem.multipleChangedFiles",
          "group": "navigation@3"
        }
      ],
      "editor/content": [
        {
          "command": "agentTandem.previousChange",
          "when": "editorFocus && isInDiffEditor && activeEditor != multiDiffEditor && resource in agentTandem.changeModifiedResources",
          "group": "navigation@1"
        },
        {
          "command": "agentTandem.nextChange",
          "when": "editorFocus && isInDiffEditor && activeEditor != multiDiffEditor && resource in agentTandem.changeModifiedResources",
          "group": "navigation@2"
        }
      ],
      "multiDiffEditor/content": [
        {
          "command": "agentTandem.previousChange",
          "when": "agentTandem.changeNavigation",
          "group": "navigation@1"
        },
        {
          "command": "agentTandem.nextChange",
          "when": "agentTandem.changeNavigation",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "agentTandem.previousFile",
          "when": "agentTandem.multipleChangedFiles"
        },
        {
          "command": "agentTandem.nextFile",
          "when": "agentTandem.multipleChangedFiles"
        },
        {
          "command": "agentTandem.chooseChangedFile",
          "when": "agentTandem.changeNavigation"
        },
        {
          "command": "agentTandem.acceptCurrentChange",
          "when": "false"
        },
        {
          "command": "agentTandem.revertCurrentChange",
          "when": "false"
        },
        {
          "command": "agentTandem.acceptHunk",
          "when": "false"
        },
        {
          "command": "agentTandem.rejectHunk",
          "when": "false"
        },
        {
          "command": "agentTandem.previousChange",
          "when": "agentTandem.changeNavigation"
        },
        {
          "command": "agentTandem.nextChange",
          "when": "agentTandem.changeNavigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "agentTandem.previousFile",
        "key": "alt+pageup",
        "when": "agentTandem.multipleChangedFiles && editorTextFocus"
      },
      {
        "command": "agentTandem.nextFile",
        "key": "alt+pagedown",
        "when": "agentTandem.multipleChangedFiles && editorTextFocus"
      },
      {
        "command": "agentTandem.acceptCurrentChange",
        "key": "alt+y",
        "when": "agentTandem.canDecideHunk && editorTextFocus"
      },
      {
        "command": "agentTandem.revertCurrentChange",
        "key": "alt+n",
        "when": "agentTandem.canDecideHunk && editorTextFocus"
      },
      {
        "command": "agentTandem.nextChange",
        "key": "alt+down",
        "when": "agentTandem.changeNavigation && editorTextFocus && isInDiffEditor"
      },
      {
        "command": "agentTandem.previousChange",
        "key": "alt+up",
        "when": "agentTandem.changeNavigation && editorTextFocus && isInDiffEditor"
      }
    ],
    "configuration": {
      "title": "AgentTandem",
      "properties": {
        "agentTandem.showQuotaInStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show agent quota in the VS Code status bar. Customize agents and details in AgentTandem Settings > Preferences."
        },
        "agentTandem.statusBarProviders": {
          "type": "string",
          "enum": [
            "both",
            "active",
            "codex",
            "claude"
          ],
          "enumDescriptions": [
            "Show Codex and Claude Code together.",
            "Show only the agent selected in chat.",
            "Show only Codex.",
            "Show only Claude Code."
          ],
          "default": "both",
          "description": "Agents shown in the status bar. Each agent has its own quota and hover details."
        },
        "agentTandem.statusBarStyle": {
          "type": "string",
          "enum": [
            "compact",
            "progress",
            "icons",
            "text"
          ],
          "enumDescriptions": [
            "Distinct agent icons with quota and a short banked reset count.",
            "Agent icons with detailed progress bars and percentages showing remaining quota.",
            "Agent icons only; hover for account, quota and reset details.",
            "Agent icons with full detail labels."
          ],
          "default": "compact",
          "description": "Appearance of the agent quota status items. Uses the Codex blossom and Claude starburst provider icons, and ↻ for banked resets."
        },
        "agentTandem.statusBarFields": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "quota",
              "reset",
              "bankedResets",
              "account",
              "plan"
            ]
          },
          "uniqueItems": true,
          "default": [
            "quota",
            "bankedResets"
          ],
          "description": "Details shown beside each agent, in this order: remaining quota, quota reset countdown, banked reset count, account and plan. Hover always shows full details. An empty list shows agent icons only."
        },
        "agentTandem.statusBarQuotaWindows": {
          "type": "string",
          "enum": [
            "all",
            "main"
          ],
          "default": "all",
          "description": "Show all reported quota windows, or only the first two for a shorter status bar. Hover always shows every window."
        },
        "agentTandem.statusBarAlignment": {
          "type": "string",
          "enum": [
            "right",
            "left"
          ],
          "default": "right",
          "description": "Side of the VS Code status bar used for agent quota."
        },
        "agentTandem.usageDashboardDefaultGrouping": {
          "type": "string",
          "enum": [
            "day",
            "week",
            "month"
          ],
          "default": "day",
          "description": "Default calendar grouping for the AgentTandem usage dashboard. Weeks start on Monday."
        },
        "agentTandem.reviewEditor": {
          "type": "string",
          "enum": [
            "webview",
            "native"
          ],
          "default": "webview",
          "enumDescriptions": [
            "Use the Monaco diff editor with syntax highlighting and colored inline Accept, Reject and navigation buttons in every edition.",
            "Use VS Code's native diff editor with the available in-editor review controls."
          ],
          "description": "Editor used to review pending changes. The Webview review editor works without experimental APIs."
        },
        "agentTandem.blockActionsStyle": {
          "type": "string",
          "enum": [
            "auto",
            "lens",
            "off"
          ],
          "enumDescriptions": [
            "Show a card with Accept, Reject and Next change buttons above each pending block, falling back to the code lens row when the editor-inset API is unavailable.",
            "Always use the compact Accept | Reject | Next change code lens row.",
            "No in-editor block actions; review files from the AgentTandem sidebar."
          ],
          "default": "lens",
          "description": "Block actions in the native diff editor. Native mode uses CodeLens. The default Monaco Webview review uses colored inline buttons. Opening a native review enables diffEditor.codeLens."
        },
        "agentTandem.showFileCounterInEditor": {
          "type": "boolean",
          "default": true,
          "description": "Show a File i/n button at the top of AgentTandem native diff editors. Click to choose a changed file. The button scrolls with the code."
        },
        "agentTandem.codexCLIId": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Managed Codex CLI entry selected for this project. Set through Manage CLIs; follows executable path edits. Takes precedence over codexExecutable."
        },
        "agentTandem.claudeCLIId": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Managed Claude CLI entry selected for this project. Set through Manage CLIs; follows executable path edits. Takes precedence over claudeExecutable."
        },
        "agentTandem.codexExecutable": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to an enabled native Codex executable in Manage CLIs. Uses the managed default or terminal PATH order when empty. A managed project entry ID takes precedence.",
          "scope": "resource"
        },
        "agentTandem.claudeExecutable": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to an enabled Claude executable in Manage CLIs. A managed project entry ID takes precedence.",
          "scope": "resource"
        },
        "agentTandem.codexCLISelection": {
          "type": "string",
          "enum": [
            "default",
            "terminal"
          ],
          "default": "default",
          "scope": "resource",
          "description": "Use the managed default/explicit executable, or the enabled terminal CLI on PATH. Configure this in Manage CLIs."
        },
        "agentTandem.claudeCLISelection": {
          "type": "string",
          "enum": [
            "default",
            "terminal"
          ],
          "default": "default",
          "scope": "resource",
          "description": "Use the managed default/explicit executable, or the enabled terminal CLI on PATH. Configure this in Manage CLIs."
        },
        "agentTandem.autoTrackExternalChanges": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start change tracking in trusted local workspaces that have no saved tracking choice. Pause/resume is remembered separately per workspace."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "gettingStarted",
        "title": "Welcome to AgentTandem",
        "description": "Use Codex and Claude your way. Track saved changes, review code and understand your usage.",
        "steps": [
          {
            "id": "tracking",
            "title": "1. Find change tracking in the status bar",
            "description": "Tracking starts automatically in trusted local workspaces. Click Tracking in the bottom status bar to control it. Manual saves are included.\n[Open tracking controls](command:agentTandem.trackingControls)",
            "media": {
              "markdown": "docs/onboarding/tracking.md"
            },
            "completionEvents": [
              "onCommand:agentTandem.trackingControls"
            ]
          },
          {
            "id": "review",
            "title": "2. Review files and individual change blocks",
            "description": "Keep applied code with Accept, or restore a saved baseline with Revert.\n[Open AgentTandem](command:agentTandem.open)",
            "media": {
              "markdown": "docs/onboarding/review.md"
            },
            "completionEvents": [
              "onCommand:agentTandem.previewReview"
            ]
          },
          {
            "id": "chat",
            "title": "3. Connect your native CLIs",
            "description": "Use the original Codex/Claude tools or chat here. Tracking works with both workflows.\n[Manage CLIs](command:agentTandem.manageCLIs)",
            "media": {
              "markdown": "docs/onboarding/chat.md"
            },
            "completionEvents": [
              "onCommand:agentTandem.manageCLIs"
            ]
          },
          {
            "id": "usage",
            "title": "4. Check account, quota and token usage",
            "description": "See where every number comes from: API, Local or Estimate.\n[Open dashboard](command:agentTandem.openSettings)",
            "media": {
              "markdown": "docs/onboarding/usage.md"
            },
            "completionEvents": [
              "onCommand:agentTandem.openSettings"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:watch": "node scripts/dev.mjs --watch",
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:extension": "npm run build && node scripts/test-extension.mjs",
    "test:changes:navigation": "npm run build && node scripts/test-change-navigation.mjs",
    "test:review:webview": "npm run build && node scripts/test-review-webview.mjs",
    "test:checkpoints": "npm run build && node scripts/test-checkpoints.mjs",
    "test:review:live": "npm run build && node scripts/test-review-live.mjs",
    "test:review:large": "npm run build && node scripts/test-review-live.mjs --large",
    "test:review:large-file": "npm run build && node scripts/test-review-live.mjs --large-file",
    "test:stop:live": "npm run build && node scripts/test-stop-live.mjs",
    "test:edit:live": "npm run build && node scripts/test-edit-live.mjs",
    "test:access:live": "npm run build && node scripts/test-access-live.mjs",
    "test:models:live": "npm run build && node scripts/test-models-live.mjs",
    "test:accounts:live": "npm run build && node scripts/test-accounts-live.mjs",
    "test:usage:accounts:live": "node scripts/test-usage-accounts-live.mjs",
    "test:cache:live": "npm run build && node scripts/test-cache-live.mjs",
    "test:attachments:live": "node scripts/test-attachments-live.mjs",
    "test:usage:local": "node scripts/test-usage-local.mjs",
    "test:settings:host": "npm run build && node scripts/test-settings-host.mjs",
    "test:queue:host": "npm run build && node scripts/test-queue-host.mjs",
    "test:cli:live": "npm run build && node scripts/test-cli-manager-live.mjs",
    "test:context:history": "npm run build && node scripts/test-context-history.mjs",
    "probe:providers": "node scripts/probe-providers.mjs",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository --no-rewrite-relative-links --skip-license --out artifacts/agent-tandem-0.1.1.vsix",
    "package:marketplace": "node scripts/package-marketplace.mjs",
    "test:marketplace": "node scripts/test-marketplace.mjs",
    "bump:patch": "node scripts/release.mjs bump patch",
    "bump:minor": "node scripts/release.mjs bump minor",
    "bump:major": "node scripts/release.mjs bump major",
    "release": "node scripts/release.mjs push",
    "vscode:prepublish": "npm run build",
    "sync:conversations": "node scripts/sync-conversations.mjs",
    "test:external-review:host": "npm run build && node scripts/test-external-review-host.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.100.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "29.1.1",
    "jsonc-parser": "^3.3.1",
    "typescript": "^5.9.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.292",
    "@vscode/codicons": "0.0.46-24",
    "acorn": "8.19.0",
    "diff": "9.0.0",
    "dompurify": "3.4.16",
    "ignore": "^7.0.5",
    "marked": "18.1.0",
    "monaco-editor": "0.57.0"
  }
}
